NODE_ENV=development

# Reverse proxy + app ports
PORT=8080
PUBLIC_PATH=/
WEB_PORT=3001
API_PORT=4000
API_BASE_URL=http://localhost:4000

# MySQL — local host dev (Docker: DB_HOST=db from container)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
# Dev OK: use platform/shared MySQL password in local .env only — never commit real secrets here.
DB_PASSWORD=changeme
DB_NAME=email_harvesting_app

# Snov.io credentials — set real values in local .env for harvesting workers; prod: set in CI/host env.
SNOV_EMAIL=
SNOV_PASSWORD=

# Apollo credentials — set in local .env / production deploy secrets.
APOLLO_EMAIL=
APOLLO_PASSWORD=

# LinkedIn credentials — set in local .env / production deploy secrets.
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=

# Browser automation
HEADLESS=true
BROWSER_TIMEOUT=30000

# Proxy configuration
PROXY_ENABLED=true
PROXY_HOST=
PROXY_PORT=
PROXY_USERNAME=
PROXY_PASSWORD=

# Application
APP_ENV=development
APP_URL=http://localhost:8080

# Production: Redis for job queue. Set in prod/CI — optional for local scaffold.
REDIS_URL=

# Production: S3-compatible object storage. Set in prod/CI before deploy.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Production: JWT signing secret. Set real value in prod/CI — use placeholder in local .env.
JWT_SECRET=dev-change-me-to-at-least-32-random-chars

# Worker tuning
WORKER_COUNT=10
MAX_PAGES_PER_DOMAIN=10
MIN_CONTACTS_PER_DOMAIN=2
RETRY_BACKOFF_SECONDS=30,60,120
