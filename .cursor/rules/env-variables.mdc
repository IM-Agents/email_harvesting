## 3. When to Call `dotenv` (`loadEnv`)

| Situation | Action |
|---|---|
| All required keys already in `process.env` | **Skip** `dotenv.config` entirely |
| Any required key missing | Call `loadEnv()` once at process entry |
| `.env` file missing | Load `.env.example` instead (warn in development only) |

```js
// packages/config/src/loadEnv.js — simplified behavior
function loadEnv({ rootDir, appName } = {}) {
  const root = rootDir ?? findMonorepoRoot();
  const required = ["PORT", "PUBLIC_PATH", "API_PORT"]; // extend in env.js

  const cli = {};
  for (const key of required) {
    if (process.env[key] !== undefined && process.env[key] !== "") {
      cli[key] = process.env[key];
    }
  }

  const allSet = required.every((k) => process.env[k] !== undefined && process.env[k] !== "");
  if (allSet) return { source: "process.env" };

  const files = resolveEnvFiles(root, appName); // see §4
  for (const file of files) {
    if (fs.existsSync(file)) dotenv.config({ path: file, override: false });
  }

  const stillMissing = required.filter((k) => !process.env[k]);
  if (stillMissing.length) {
    const example = path.join(root, ".env.example");
    if (fs.existsSync(example)) dotenv.config({ path: example, override: false });
  }

  Object.assign(process.env, cli); // shell/CLI wins for REQUIRED_KEYS

  applyProjectDatabaseEnv(root); // see § Database env priority
}
```

- **`override: false`** — never replace variables already set in `process.env`.
- Call `loadEnv()` **once** at the top of: API entry, webpack config, `preview-start.js`, `proxy.js`, test setup.

### Database env priority (Required — `@repo/config/loadEnv`)

After `dotenv.config({ override: false })` for each file:

| Variable | Winner | Reason |
|----------|--------|--------|
| `DB_HOST`, `DB_PORT`, `DB_USER`, `DB_PASSWORD` | **Shell / Docker** if already set | IM platform container injects `DB_HOST=db` |
| `DB_NAME` | **`{monorepo}/.env` only** | Child app must not inherit parent `{platform_db_name}` |

```js
// packages/config/src/loadEnv.js — after all dotenv loads, before CLI restore for PORT/PUBLIC_PATH
function applyProjectDatabaseEnv(rootDir) {
  const rootEnv = path.join(rootDir, ".env");
  if (!fs.existsSync(rootEnv)) return;
  const parsed = dotenv.parse(fs.readFileSync(rootEnv));
  if (parsed.DB_NAME) process.env.DB_NAME = parsed.DB_NAME;
}
```

- **MUST** implement `applyProjectDatabaseEnv` (or equivalent) in shared `loadEnv` for monorepos on IM platform.
- **MUST NOT** let parent `DB_NAME={platform_db_name}` override `{monorepo}/.env` `{db_name}`.
- **MUST NOT** let `{monorepo}/.env` `DB_HOST=localhost` override Docker `DB_HOST=db` when `process.env.DB_HOST` was set before `loadEnv`.

**Examples:** `{root folder name}` = `login`, `{db_name}` = `login_app` in `{monorepo}/.env` — see `{monorepo}/README.md` for product-specific values.

