## 7. Anti-Patterns

```js
// ❌ BAD — direct dotenv in app
require("dotenv").config();
const port = process.env.PORT || 3000;

// ❌ BAD — @repo/config outside config folder
const { env } = require("@repo/config/env");
app.listen(env.PORT);

// ❌ BAD — env in routes/controllers
const db = process.env.DATABASE_URL;

// ❌ BAD — overwrites CI-injected env
dotenv.config({ override: true });

// ❌ BAD — browser DefinePlugin uses API_BASE_URL (absolute localhost URL)
__API_BASE_URL__: JSON.stringify(process.env.API_BASE_URL || "/api")

// ❌ BAD — subpath prod: endpoint missing /api (404 on preview/deploy)
apiFetch("/v1/...")  // → /qa/{root folder name}/v1/... — proxy ignores

// ✅ GOOD — only from app config folder
const { env } = require("./config/env");
app.listen(env.API_PORT);

// ✅ GOOD — browser base = PUBLIC_PATH in prod; endpoint includes /api
__API_BASE_URL__: JSON.stringify(isDev ? "/api" : publicPathOrApi)
apiFetch("/api/v1/...")
```

